{
    "name": "horde/managesieve",
    "description": "ManageSieve client library",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-04-14",
    "repositories": [],
    "require": {
        "php": "^7.4 || ^8",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/socket_client": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {},
    "suggest": {
        "pear/auth_sasl": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Horde\\ManageSieve\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\ManageSieve\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "2.x-dev"
        }
